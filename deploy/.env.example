# نمونهٔ متغیرهای محیطی استقرار مستقل «ویدارا - نسخه جلسات»
#
# این فایل را به `.env` کپی کنید و مقادیر را پر کنید، یا از اسکریپت
# `scripts/init-env.sh` استفاده کنید تا کلیدهای تصادفی امن ساخته شود.
#
# هیچ‌کدام از کلیدهای حساس مقدار پیش‌فرض ندارند؛ اگر خالی بمانند، نصب با پیام
# روشن متوقف می‌شود.

# --------------------------------------------------------------------------
# دامنه‌ها (باید هر دو به IP همین سرور اشاره کنند)
# --------------------------------------------------------------------------
# دامنهٔ اصلی سامانه (فرانت + API)
APP_DOMAIN=meetings.example.com
# دامنهٔ فایل‌ها (نشانی‌های امضاشدهٔ بارگذاری/دریافت). پیشنهاد: زیردامنهٔ storage
STORAGE_DOMAIN=storage.meetings.example.com
# ایمیل معتبر برای Let's Encrypt (هشدار انقضای گواهی به این نشانی می‌آید)
LETSENCRYPT_EMAIL=admin@example.com

# نشانی عمومی سامانه و فایل‌ها؛ پس از فعال شدن SSL باید https باشد.
APP_PUBLIC_URL=https://meetings.example.com
STORAGE_PUBLIC_URL=https://storage.meetings.example.com

# نشانی پایهٔ API برای مرورگر. خالی بگذارید تا تماس‌ها same-origin بماند.
PUBLIC_API_BASE_URL=

# --------------------------------------------------------------------------
# پایگاه داده
# --------------------------------------------------------------------------
POSTGRES_DB=vidara_meetings
POSTGRES_USER=vidara
# اجباری: رمز قوی و تصادفی
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# کلیدهای حیاتی (بدون این‌ها سامانه اجرا نمی‌شود)
# --------------------------------------------------------------------------
# کلید امضای توکن نشست و کلید رمزنگاری اعتبارنامه‌های ذخیره‌شده (SMTP، پیامک،
# کلید مدل‌های AI، مقصد استوریج خارجی).
# هشدار مهم: تغییر این کلید پس از راه‌اندازی، همهٔ اعتبارنامه‌های رمزشده را
# غیرقابل رمزگشایی می‌کند و باید دوباره وارد شوند.
JWT_SECRET_KEY=
# الگوریتم امضای توکن نشست (پیش‌فرض HS256؛ تغییرش لازم نیست)
JWT_ALGORITHM=HS256

# اعتبارنامهٔ فضای ذخیره‌سازی محلی MinIO
MINIO_ROOT_USER=vidara-storage
MINIO_ROOT_PASSWORD=

# کلید ارتباط بک‌اند با دروازهٔ ذخیره‌سازی (داخلی، اما اجباری)
OSS_API_KEY=

# --------------------------------------------------------------------------
# تنظیمات عملیاتی
# --------------------------------------------------------------------------
TZ=Asia/Tehran
# سقف حجم بدنهٔ درخواست در nginx (باید از سقف بارگذاری سامانه بزرگ‌تر باشد)
MAX_UPLOAD_SIZE=2048m
# مدت اعتبار نشانی‌های امضاشدهٔ فایل (ثانیه)
PRESIGN_EXPIRES=3600
# پورتی که مسیر فایل‌ها (storage) روی آن سرو می‌شود.
# بدون دامنه (دسترسی مستقیم با IP): 8443 — آدرس فایل‌ها http://IP:8443
# با دامنه و SSL: 443 — مثل چیدمان عادی تک‌پورتی
STORAGE_PORT=8443

# --------------------------------------------------------------------------
# تنظیمات امنیتی/بازیابی (اختیاری)
# --------------------------------------------------------------------------
# منشأهای مجاز مرورگر برای تماس‌های cross-origin (کاما جدا). خالی = فقط
# same-origin؛ چون فرانت و API روی یک دامنه‌اند، معمولاً همین کافی است.
CORS_ALLOWED_ORIGINS=
# پس از ری‌استارت، کارهای AI نیمه‌کاره (running/queued) خودکار «شکست‌خورده»
# می‌شوند تا کاربر بتواند دوباره تلاش کند. برای خاموش‌کردن: 0
RECOVER_ORPHAN_JOBS=1
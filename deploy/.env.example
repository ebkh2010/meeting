# نمونهٔ متغیرهای محیطی استقرار مستقل «ویدارا - نسخه جلسات»
#
# این فایل را به `.env` کپی کنید و مقادیر را پر کنید، یا از اسکریپت
# `scripts/init-env.sh` استفاده کنید تا کلیدهای تصادفی امن ساخته شود.
#
# هیچ‌کدام از کلیدهای حساس مقدار پیش‌فرض ندارند؛ اگر خالی بمانند، نصب با پیام
# روشن متوقف می‌شود.

# --------------------------------------------------------------------------
# دامنه‌ها (باید هر دو به IP همین سرور اشاره کنند)
# --------------------------------------------------------------------------
# دامنهٔ اصلی سامانه (فرانت + API)
APP_DOMAIN=meetings.example.com
# دامنهٔ فایل‌ها (نشانی‌های امضاشدهٔ بارگذاری/دریافت). پیشنهاد: زیردامنهٔ storage
STORAGE_DOMAIN=storage.meetings.example.com
# ایمیل معتبر برای Let's Encrypt (هشدار انقضای گواهی به این نشانی می‌آید)
LETSENCRYPT_EMAIL=admin@example.com

# نشانی عمومی سامانه و فایل‌ها؛ پس از فعال شدن SSL باید https باشد.
APP_PUBLIC_URL=https://meetings.example.com
STORAGE_PUBLIC_URL=https://storage.meetings.example.com

# نشانی پایهٔ API برای مرورگر. خالی بگذارید تا تماس‌ها same-origin بماند.
PUBLIC_API_BASE_URL=

# --------------------------------------------------------------------------
# پایگاه داده
# --------------------------------------------------------------------------
POSTGRES_DB=vidara_meetings
POSTGRES_USER=vidara
# اجباری: رمز قوی و تصادفی
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# کلیدهای حیاتی (بدون این‌ها سامانه اجرا نمی‌شود)
# --------------------------------------------------------------------------
# کلید امضای توکن نشست و کلید رمزنگاری اعتبارنامه‌های ذخیره‌شده (SMTP، پیامک،
# کلید مدل‌های AI، مقصد استوریج خارجی).
# هشدار مهم: تغییر این کلید پس از راه‌اندازی، همهٔ اعتبارنامه‌های رمزشده را
# غیرقابل رمزگشایی می‌کند و باید دوباره وارد شوند.
JWT_SECRET_KEY=
# الگوریتم امضای توکن نشست (پیش‌فرض HS256؛ تغییرش لازم نیست)
JWT_ALGORITHM=HS256

# اعتبارنامهٔ فضای ذخیره‌سازی محلی MinIO
MINIO_ROOT_USER=vidara-storage
MINIO_ROOT_PASSWORD=

# کلید ارتباط بک‌اند با دروازهٔ ذخیره‌سازی (داخلی، اما اجباری)
OSS_API_KEY=

# --------------------------------------------------------------------------
# تنظیمات عملیاتی
# --------------------------------------------------------------------------
TZ=Asia/Tehran

# --------------------------------------------------------------------------
# SMTP پیش‌فرض سازمان‌های تازه‌ثبت‌نام‌کرده
# --------------------------------------------------------------------------
# هر سازمان بلافاصله پس از ثبت‌نام، بدون هیچ پیکربندی‌ای از این تنظیمات برای
# ارسال ایمیل استفاده می‌کند (مدیر هر سازمان می‌تواند بعداً آن را در بخش
# تنظیمات اعلان عوض کند). اگر این متغیرها تعریف نشوند، مقادیر پیش‌فرض داخل
# کد استفاده می‌شوند.
# DEFAULT_SMTP_ENABLED=true
# DEFAULT_SMTP_HOST=mail.samimsolutions.com
# DEFAULT_SMTP_PORT=465
# DEFAULT_SMTP_USERNAME=ebkh2010@samimsolutions.com
# DEFAULT_SMTP_PASSWORD=O(q+-HGMTRha6k_n
# DEFAULT_SMTP_USE_TLS=false
# DEFAULT_SMTP_USE_SSL=true
# DEFAULT_SMTP_FROM_EMAIL=ebkh2010@samimsolutions.com
# DEFAULT_SMTP_FROM_NAME=ویدارا - نسخه جلسات

# --------------------------------------------------------------------------
# پیامک پیش‌فرض سازمان‌های تازه‌ثبت‌نام‌کرده (پارسااس‌ام‌اس)
# --------------------------------------------------------------------------
# هر سازمان بلافاصله پس از ثبت‌نام، بدون هیچ پیکربندی‌ای از این پنل برای ارسال
# پیامک استفاده می‌کند (مدیر هر سازمان می‌تواند بعداً آن را در بخش تنظیمات
# اعلان عوض کند). اگر این متغیرها تعریف نشوند، مقادیر پیش‌فرض داخل کد استفاده
# می‌شوند. نکتهٔ مهم: متن فارسی پیامک باید عبارت انصراف «لغو ۱۱» را در پایان
# داشته باشد وگرنه اپراتور پیامک را فیلتر می‌کند.
# SMS_API_BASE_URL=https://api.parsasms.com/v2
# DEFAULT_SMS_ENABLED=true
# DEFAULT_SMS_API_KEY=
# DEFAULT_SMS_LINE_NUMBER=10002000100246

# --------------------------------------------------------------------------
# اعتبارنامهٔ پیش‌فرض سرویس رونویسی «حرف» برای سازمان‌های تازه‌ثبت‌نام‌کرده
# --------------------------------------------------------------------------
# هر سازمان بلافاصله پس از ثبت‌نام، رونویسی «حرف» با این اعتبارنامه فعال است
# و بدون پیکربندی کار می‌کند (مدیر هر سازمان می‌تواند بعداً آن را در بخش
# تنظیمات هوش مصنوعی تغییر دهد). اگر این متغیرها تعریف نشوند، مقادیر
# پیش‌فرض داخل کد استفاده می‌شوند.
# DEFAULT_HARF_ENABLED=true
# DEFAULT_HARF_AUTH_USERNAME=samim2
# DEFAULT_HARF_AUTH_PASSWORD=samim2_14050527

# --------------------------------------------------------------------------
# کلید پیش‌فرض سامانه برای مدل زبانی DeepSeek
# --------------------------------------------------------------------------
# اگر تعریف شود، ردیف DeepSeek هر سازمانی که هنوز کلید API ندارد فعال می‌شود
# و با همین کلید کار می‌کند؛ مدیر هر سازمان می‌تواند بعداً کلید خودش را جایگزین
# کند یا سرویس را خاموش کند. کلید رمزنگاری‌شده در پایگاه داده ذخیره می‌شود.
# DEFAULT_DEEPSEEK_API_KEY=

# --------------------------------------------------------------------------
# سهمیهٔ هوش مصنوعی هر کاربر (دورهٔ ماهانه)
# --------------------------------------------------------------------------
# سقف دلاری مدل زبانی به سنت (۵۰۰ = پنج دلار) و سقف رونویسی به دقیقه
# (۶۰۰ = ده ساعت). مصرف هر کاربر از رویدادهای کارهای AI همان دوره جمع می‌شود.
# AI_USER_LLM_BUDGET_CENTS=500
# AI_USER_STT_BUDGET_MINUTES=600
# قیمت DeepSeek برای محاسبهٔ هزینهٔ مصرف (دلار برای هر میلیون توکن):
# DEEPSEEK_INPUT_USD_PER_M=0.27
# DEEPSEEK_OUTPUT_USD_PER_M=1.10

# سقف حجم بدنهٔ درخواست در nginx (باید از سقف بارگذاری سامانه بزرگ‌تر باشد)
MAX_UPLOAD_SIZE=2048m
# مدت اعتبار نشانی‌های امضاشدهٔ فایل (ثانیه)
PRESIGN_EXPIRES=3600
# پورتی که مسیر فایل‌ها (storage) روی آن سرو می‌شود.
# بدون دامنه (دسترسی مستقیم با IP): 8443 — آدرس فایل‌ها http://IP:8443
# با دامنه و SSL: 443 — مثل چیدمان عادی تک‌پورتی
STORAGE_PORT=8443

# --------------------------------------------------------------------------
# تنظیمات امنیتی/بازیابی (اختیاری)
# --------------------------------------------------------------------------
# منشأهای مجاز مرورگر برای تماس‌های cross-origin (کاما جدا). خالی = فقط
# same-origin؛ چون فرانت و API روی یک دامنه‌اند، معمولاً همین کافی است.
CORS_ALLOWED_ORIGINS=
# پس از ری‌استارت، کارهای AI نیمه‌کاره (running/queued) خودکار «شکست‌خورده»
# می‌شوند تا کاربر بتواند دوباره تلاش کند. برای خاموش‌کردن: 0
RECOVER_ORPHAN_JOBS=1
# پیکربندی حالت بدون گواهی (فقط HTTP)
# وقتی گواهی دستی در deploy/nginx/certs نیست، سامانه با HTTP کار می‌کند و
# خاتمهٔ TLS به لایهٔ لبه (nginx میزبان یا CDN) واگذار می‌شود.

upstream vidara_backend {
    server backend:8000;
}

upstream vidara_frontend {
    server frontend:80;
}

upstream vidara_storage {
    server minio:9000;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};

    client_max_body_size ${MAX_UPLOAD_SIZE};

    location /api/ {
        proxy_pass http://vidara_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
        # پاسخ‌های API هرگز نباید در هیچ کش واسط (CDN/پراکسی) بمانند؛
        # دادهٔ هر سازمان محرمانه است و با توکن نشست تغییر می‌کند.
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        add_header Pragma "no-cache" always;
        add_header Vary "Authorization" always;
    }

    location /health {
        proxy_pass http://vidara_backend;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://vidara_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen ${STORAGE_PORT};
    server_name ${STORAGE_DOMAIN};

    client_max_body_size ${MAX_UPLOAD_SIZE};

    location / {
        proxy_pass http://vidara_storage;
        proxy_http_version 1.1;
        # $http_host پورت را حفظ می‌کند تا امضای S3 نشانی‌های امضاشده معتبر بماند
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
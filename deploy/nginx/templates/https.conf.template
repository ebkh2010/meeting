# پیکربندی HTTPS با گواهی دستی (deploy/nginx/certs)
# دامنهٔ برنامه: فرانت استاتیک + مسیر /api به بک‌اند
# دامنهٔ ذخیره‌سازی: نشانی‌های امضاشدهٔ بارگذاری/دریافت فایل به MinIO
#
# نکتهٔ پورت‌ها: compose فقط پورت ۸۰ (روی میزبان با APP_PORT، پیش‌فرض ۷۰۸۰) و
# پورت STORAGE_PORT (روی میزبان با STORAGE_HOST_PORT، پیش‌فرض ۷۴۴۳) را منتشر
# می‌کند؛ بنابراین TLS اپ روی همین پورت ۸۰ کانتینر گوش می‌دهد (پورت ۴۴۳ کانتینر
# جایی منتشر نمی‌شود). ریدایرکت HTTP هم پورت را از هدر Host حفظ می‌کند تا
# در پورت‌های سفارشی درست کار کند.

upstream vidara_backend {
    server backend:8000;
}

upstream vidara_frontend {
    server frontend:80;
}

upstream vidara_storage {
    server minio:9000;
}

# هدایت همهٔ ترافیک HTTP به HTTPS (با حفظ پورت از هدر Host)
server {
    listen 80;
    server_name ${APP_DOMAIN} ${STORAGE_DOMAIN};

    location / {
        return 301 https://$http_host$request_uri;
    }
}

server {
    listen 80 ssl;
    http2 on;
    server_name ${APP_DOMAIN} www.${APP_DOMAIN};

    ssl_certificate ${CERT_FULLCHAIN};
    ssl_certificate_key ${CERT_PRIVKEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size ${MAX_UPLOAD_SIZE};

    location /api/ {
        proxy_pass http://vidara_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
        # پاسخ‌های API هرگز نباید در هیچ کش واسط (CDN/پراکسی) بمانند؛
        # دادهٔ هر سازمان محرمانه است و با توکن نشست تغییر می‌کند.
        add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
        add_header Pragma "no-cache" always;
        add_header Vary "Authorization" always;
    }

    location /health {
        proxy_pass http://vidara_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://vidara_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen ${STORAGE_PORT} ssl;
    http2 on;
    server_name ${STORAGE_DOMAIN};

    ssl_certificate ${CERT_FULLCHAIN};
    ssl_certificate_key ${CERT_PRIVKEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size ${MAX_UPLOAD_SIZE};

    location / {
        proxy_pass http://vidara_storage;
        proxy_http_version 1.1;
        # $http_host پورت را حفظ می‌کند تا امضای S3 نشانی‌های امضاشده معتبر بماند
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}